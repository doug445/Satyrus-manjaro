#!/bin/bash
# aur-pin-check — refuse AUR packages whose PKGBUILD uses unpinned VCS sources,
# or downloads something nothing verifies.
#
# Pinning policy — every VCS source in the PKGBUILD must carry the fragment that
# names one immutable revision for that VCS:
#
#   git           #commit=<40-hex>
#   fossil        #commit=<40-hex or 64-hex>
#   hg            #revision=<40-hex> (the changeset hash)
#   svn, bzr      #revision=<N>
#
# The fragment is taken the way makepkg takes it -- from the first `#` of the
# whole entry, filename prefix included -- and has to be that pin and nothing
# else. makepkg reads the kind up to the first `=` and the value after the last,
# so `#commit=<sha>?=main` is the branch and `#tag=v1?x#commit=<sha>` is the tag;
# looking for `#commit=` somewhere in the string accepted both. 64-hex is not a
# git pin: on a SHA-1 repository, git resolves such a string as a ref name, and
# a tag of that name can move.
#
# Tag fragments (`#tag=...`) and branch fragments are REJECTED because upstream
# can re-point them. A `?signed` query after the fragment is makepkg asking for
# a signature check on top of the pin; it is accepted.
#
# Checksum policy — every other REMOTE source must be verified by something:
#
#   a real checksum   in md5sums, sha1sums, sha224sums, sha256sums, sha384sums,
#                     sha512sums or b2sums, at the source's own position, in
#                     the array of its own architecture
#   or a signature    a detached .sig/.sign/.asc for it in the source list,
#                     which makepkg verifies and refuses the build without
#
# `SKIP` in a checksum array tells makepkg to verify nothing, and it accepts
# that for any source, not only VCS ones. A tarball URL under SKIP is as
# mutable as an unpinned branch — what you audited last week is whatever the
# server sends today — and up to 1.7.0 it passed here on the stated ground
# that "sha256sums cover it". `cksums` does not count: it is a CRC, and a CRC
# is matched by anyone who wants to. A local file (no `://`) is not a
# download; it ships in the AUR repository beside the PKGBUILD and is read
# with it. There is no allowlist for this: a moving download has no revision
# to record, so there is nothing a row could re-verify.
#
# The git/hg/fossil pins are content-addressed: the hash IS the tree. An svn or
# bzr revision number is not — it identifies a revision only as long as the
# server is honest, which is the same trust the tag allowlist below places in a
# live `git ls-remote`. It is still a pin: the same revision you reviewed, under
# an honest server, rather than whatever HEAD is today.
#
# Reads .SRCINFO (post-eval, no bash execution) from AUR's cgit. Safe to
# run on untrusted package names: only does an HTTPS fetch + text parse.
#
# Every name goes through the AUR's RPC index first. That is what says the
# package exists and which pkgbase it belongs to; cgit cannot, because it keeps
# the branches of deleted packages forever. A .SRCINFO fetched straight by name
# could belong to a repository the AUR dropped years ago, which is then not what
# `yay -S` builds: it may build a provider of that name, or the live split
# package the old branch is shadowing. Not indexed is an ERROR, and so is an
# index that could not be asked: an unchecked package is never a pass. And what
# comes back has to be what was asked for. A captive portal or an anti-bot page
# answers 200 with HTML, in which no unpinned source would ever be found.
#
# .SRCINFO is written by the maintainer, and the AUR never checks it against
# the PKGBUILD. So the PKGBUILD is read too — as text, never executed — and a
# package is REJECTED when the two disagree: its source arrays name more
# unpinned VCS sources than its .SRCINFO admits to, or any source URL, checksum
# or signing key differs (see pkgbuild_elements). That catches a .SRCINFO that
# hides a source, or shows a hash makepkg will never check, and one that has
# simply been left behind. It is a tripwire, not a proof: a PKGBUILD is code,
# and one that builds its URL at run time, or does its damage in build(), passes
# any static check. The defence against a hostile maintainer is reading the
# PKGBUILD.
#
# Allowlist (escape hatch for tag-pinned upstreams):
#   /etc/aur-pin-check/allowlist.conf — one rule per line:
#     <pkgbase>  <vcs-source-spec>  <expected-40-hex-sha>
#   When a plain `git+...#tag=<name>` source matches an allowlist rule, the
#   upstream tag is resolved live with `git ls-remote` and accepted only if the
#   SHA still matches the recorded value. If upstream silently moves the tag,
#   the SHA changes and the package is rejected on the next run — TOFU
#   semantics, no blanket trust.
#
# Usage:
#   aur-pin-check pkg1 pkg2 ...
#   aur-pin-check --deps pkg ...     # also every AUR package their build pulls
#                                    # in: depends, makedepends, checkdepends
#   aur-pin-check --from-aur pkg ... # check even a name a binary repo carries:
#                                    # for callers about to build it from the AUR
#   aur-pin-check --pkgbase base ... # the names are pkgbases already, and the
#                                    # endpoints point at their clones: aurinstall
#                                    # checking what it is about to build. A
#                                    # pkgbase is not an index entry, so the RPC
#                                    # is not asked
#
# By default a name a binary repository carries is skipped: `yay -S` installs
# the repo copy, so the AUR's is not what lands. A caller that builds from the
# AUR whatever the repos hold (aurinstall's chroot) passes --from-aur. With
# --deps, a dependency is walked only when nothing installed and nothing in a
# binary repo satisfies it — exactly the ones yay would build — and always
# with --from-aur semantics: a repo copy that is too old is why it is built.
#
# On REJECT, says whether the package is an installed orphan that should simply
# be removed rather than allowlisted.
#
# Exit: 0 every source pinned or verified; 1 any unpinned or unverified source,
#       or any package that could not be looked up, fetched or read (an
#       unchecked package is never a pass); 2 usage error.

set -uo pipefail

ALLOWLIST="${AUR_PIN_ALLOWLIST:-/etc/aur-pin-check/allowlist.conf}"

# Endpoints, as printf formats taking the package name. Overridable so the
# fixture suite can point them at local files -- there is no other way to
# exercise the parser and the TOFU logic without hitting the real AUR on
# every test run. Nothing but tests should ever set these.
AUR_SRCINFO_URL="${AUR_SRCINFO_URL:-https://aur.archlinux.org/cgit/aur.git/plain/.SRCINFO?h=%s}"
AUR_RPC_URL="${AUR_RPC_URL:-https://aur.archlinux.org/rpc/v5/info?arg%%5B%%5D=%s}"
AUR_PKGBUILD_URL="${AUR_PKGBUILD_URL:-https://aur.archlinux.org/cgit/aur.git/plain/PKGBUILD?h=%s}"

walk_deps=0
from_aur=0
name_is_base=0
while (( $# > 0 )); do
    case "$1" in
        --deps)     walk_deps=1; shift ;;
        --from-aur) from_aur=1; shift ;;
        --pkgbase)  name_is_base=1; shift ;;
        --)         shift; break ;;
        -*)         echo "aur-pin-check: unknown option: $1" >&2; exit 2 ;;
        *)          break ;;
    esac
done

(( $# > 0 )) || { echo "usage: $0 [--deps] [--from-aur] [--pkgbase] <pkg>..." >&2; exit 2; }

# Every verdict below rests on these, and a process substitution hides a tool
# that dies: with awk broken by a half-finished upgrade, no source would be read
# and no source would be refused. So they are made to prove they work first.
if [[ "$(printf 'x y\n' | awk '{ print $2 }' | grep y | sed 's/y/z/' | cut -c1 | sort)" != z ]]; then
    echo "[pin-check] ERROR: awk, grep, sed, cut or sort is not working — nothing can be checked" >&2
    exit 1
fi

# What came off the network, made safe to print: a hostile .SRCINFO must not get
# to write escape sequences to the terminal that is reading the verdict.
clean() { LC_ALL=C tr -d '\000-\010\013-\037\177'; }

# makepkg's rule for a package name, with the upper case the AUR's oldest names
# still carry. A dependency string comes from the network; anything else cannot
# be a package, and is not worth a request.
valid_name() { [[ "$1" =~ ^[A-Za-z0-9@_+][A-Za-z0-9@._+-]*$ ]]; }

# Percent-encode a package name for a URL. Names may carry '+' and '@'; sent
# raw, cgit and the RPC read '+' as a space, and `aewm++` was a 404 forever.
# A file:// URL is decoded by curl the same way, so the fixtures still match.
urlenc() {
    local s="$1" out="" c i
    for (( i = 0; i < ${#s}; i++ )); do
        c=${s:i:1}
        case "$c" in
            [A-Za-z0-9._~-]) out+="$c" ;;
            *) printf -v c '%%%02X' "'$c"; out+="$c" ;;
        esac
    done
    printf '%s' "$out"
}

# Look up an allowlist rule. Echoes the expected SHA on stdout if a row matches
# (pkgbase + exact source spec). No output if no match. ENVIRON and not -v: awk
# decodes backslashes in -v, so `#tag=v1\.0` would match a row for `#tag=v1.0`.
allowlist_sha() {
    [[ -r "$ALLOWLIST" ]] || return 1
    ROW_PKG="$1" ROW_SPEC="$2" awk '
        /^[[:space:]]*#/ || NF < 3 { next }
        $1 == ENVIRON["ROW_PKG"] && $2 == ENVIRON["ROW_SPEC"] { print $3; exit }
    ' "$ALLOWLIST"
}

# Can this entry be allowlisted at all? Only a plain tag: makepkg takes the value
# after the LAST `=`, so in `#tag=decoy?=evil` the name the gate would resolve is
# not the one that gets built, and a `#` in the filename prefix moves the whole
# fragment somewhere the row never looked.
allowlistable() {
    local spec="$1"
    [[ "$(source_proto "$spec")" == git ]] || return 1
    [[ "${spec#*#}" =~ ^tag=[^=?#[:space:]]+$ ]]
}

# Resolve a `git+<url>#tag=<name>` source to its current upstream SHA. Returns
# empty on any failure. `git ls-remote` matches a pattern against the TAIL of a
# ref name, so it also answers for a decoy called `0/refs/tags/<name>`: only the
# line whose ref is exactly this tag counts, wherever in the output it comes.
resolve_git_tag() {
    local spec="$1" url tag
    url="${spec#git+}"
    tag="${url##*#tag=}"
    url="${url%%#*}"
    [[ -n "$tag" ]] || return 1
    git ls-remote --tags --refs "$url" "refs/tags/$tag" 2>/dev/null \
        | WANT_REF="refs/tags/$tag" awk '$2 == ENVIRON["WANT_REF"] { print $1 }'
}

# Fetch the AUR RPC info record for a name. Echoes the body; fails on any
# transport error so callers can tell "not indexed" from "could not ask".
rpc_info() {
    local rpc; printf -v rpc "$AUR_RPC_URL" "$(urlenc "$1")"
    curl -fsSL --max-time 10 "$rpc" 2>/dev/null
}

# The pkgbase a package name belongs to, per the RPC: 0 and the pkgbase, 1 not
# in the index, 2 could not tell. An RPC error reply carries resultcount:0 as
# well -- a rate limit is not a deleted package -- so its type is looked at first.
aur_pkgbase() {
    local body base
    body=$(rpc_info "$1") || return 2
    case "$body" in
        *'"type":"error"'*)  return 2 ;;
        *'"resultcount":0'*) return 1 ;;
        *'"resultcount":'*)  ;;
        *)                   return 2 ;;
    esac
    base=$(grep -oE '"PackageBase":"[^"]+"' <<<"$body" | cut -d'"' -f4 | sed -n 1p)
    valid_name "$base" || return 2
    printf '%s\n' "$base"
}

# Fetch the .SRCINFO of a pkgbase.
fetch_srcinfo() {
    local url body
    printf -v url "$AUR_SRCINFO_URL" "$(urlenc "$1")"
    body=$(curl -fsSL --max-time 15 "$url" 2>/dev/null) && [[ -n "$body" ]] || return 1
    printf '%s\n' "$body"
}

# The PKGBUILD of a pkgbase, as text. Never sourced, never executed.
fetch_pkgbuild() {
    local url body
    printf -v url "$AUR_PKGBUILD_URL" "$(urlenc "$1")"
    body=$(curl -fsSL --max-time 15 "$url" 2>/dev/null) && [[ -n "$body" ]] || return 1
    printf '%s\n' "$body"
}

# The checksum algorithms that count as verification. Not `ck`: cksums is a CRC.
SUM_ALGOS='md5|sha1|sha224|sha256|sha384|sha512|b2'

# The arrays compared between a PKGBUILD and its .SRCINFO. cksums is in this
# list although it verifies nothing: a difference in it is still a difference.
COMPARED_ARRAYS="source(_[A-Za-z0-9_]+)?|(ck|$SUM_ALGOS)sums(_[A-Za-z0-9_]+)?|validpgpkeys"

# A PKGBUILD's source, checksum and signing-key arrays, read as text. Nothing is
# sourced or evaluated: quotes, comments and line continuations are tokenised
# here, and every expansion is either looked up or given up on.
#
# A simple top-level assignment (`_commit=abc`, `pkgver=1.2`, `url="https://x"`)
# is substituted, since most real sources carry $pkgver. Anything else that
# expands -- a command substitution, ${pkgver%.*}, a variable assigned twice or
# inside a function or an `if` -- becomes \001, a wildcard that matches any text.
# So an array is only ever judged on what can be known without running it, and
# legitimate shell cannot produce a false alarm.
#
# Output, one line per record, tab-separated:
#   S <array> set|add|cond   a statement: `x=(` | `x+=(` | either, conditionally
#   E <array> <element>      one element, in order
#   A <array> <n> <element>  `x[n]=element`, unconditionally
#   D <array>                the element count cannot be known statically
#   X <array>                it could not be read: an array never closed
# A statement counts as conditional when indented or inside if/case/for/while:
# only one branch of it reached the .SRCINFO. Heredoc bodies are text, not code,
# and are skipped. LC_ALL=C makes substr() O(1).
pkgbuild_elements() {
    LC_ALL=C awk -v names="$COMPARED_ARRAYS" '
        BEGIN {
            U = "\001"
            head = "^[[:space:]]*(" names ")\\+?=\\("
            # The same statement after something on its line: `if x; then a=(`
            before = "([;&|({]|then[[:space:]]|do[[:space:]]|else[[:space:]]|(declare|typeset)[[:space:]]+(-[[:alpha:]]+[[:space:]]+)*)[[:space:]]*"
            mid = before "(" names ")\\+?=\\("
            # One element by subscript. Real packages do this: `sha512sums[4]=SKIP`
            sub1 = "(^[[:space:]]*|" before ")(" names ")\\[[^]]*\\]="
        }

        function value(nm, depth) {
            if (!(nm in RAW) || (nm in BAD) || depth >= 8) return U
            return word(RAW[nm], 1, depth + 1)
        }

        # One shell word of s from i. WORD_END is left just past it, WORD_DYN
        # set when it may expand to any number of words.
        function word(s, i, depth,    n, c, nx, cl, out, q, j, d, inner, quoted, dyn) {
            n = length(s); out = ""; q = ""; quoted = 0; dyn = 0
            for (; i <= n; i++) {
                c = substr(s, i, 1)
                if (q == "\047") { if (c == "\047") q = ""; else out = out c; continue }
                if (c == "\\") {
                    nx = substr(s, ++i, 1)
                    if (nx == "\n") continue
                    if (q != "" && index("$`\"\\", nx) == 0) out = out c
                    out = out nx; continue
                }
                if (q == "\"") { if (c == "\"") { q = ""; continue } }
                else {
                    if (c == "\047" || c == "\"") { q = c; quoted = 1; continue }
                    if (c ~ /[[:space:]);&|]/) break
                    if (c == "{") {                # brace expansion?
                        j = index(substr(s, i), "}")
                        inner = j ? substr(s, i, j) : ""
                        if (inner ~ /,|\.\./ && inner !~ /[[:space:]]/) {
                            dyn = 1; out = out U; i += j - 1; continue
                        }
                    }
                }
                if (c == "`") {
                    j = index(substr(s, i + 1), "`"); i = j ? i + j : n
                    out = out U; continue
                }
                if (c != "$") { out = out c; continue }
                nx = substr(s, i + 1, 1)
                if (nx == "(" || nx == "{") {
                    cl = (nx == "(") ? ")" : "}"
                    d = 0
                    for (j = i + 1; j <= n; j++) {
                        c = substr(s, j, 1)
                        if (c == nx) d++
                        else if (c == cl && --d == 0) break
                    }
                    inner = substr(s, i + 2, j - i - 2)
                    i = j
                    if (nx == "{" && inner ~ /^[A-Za-z_][A-Za-z0-9_]*$/) {
                        out = out value(inner, depth); continue
                    }
                    if (inner ~ /\[[@*]\]/) dyn = 1
                    out = out U; continue
                }
                if (match(substr(s, i + 1, 128), /^[A-Za-z_][A-Za-z0-9_]*/)) {
                    j = RLENGTH
                    out = out value(substr(s, i + 1, j), depth); i += j; continue
                }
                if (nx == "@" || nx == "*") { dyn = 1; out = out U; i++; continue }
                if (nx != "" && index("0123456789#?$!-", nx)) { out = out U; i++; continue }
                out = out c
            }
            if (out == U && !quoted) dyn = 1       # a bare $x can split into words
            WORD_END = i; WORD_DYN = dyn; WORD_QUOTED = quoted
            return out
        }

        # Emit the elements of the array whose body starts at i; returns the
        # offset of its closing parenthesis.
        function array(name, i, kind,    n, c, j, w) {
            printf "S\t%s\t%s\n", name, kind
            n = length(T)
            while (i <= n) {
                c = substr(T, i, 1)
                if (c ~ /[[:space:]]/) { i++; continue }
                if (c == ")") return i
                if (c == "#") {
                    j = index(substr(T, i), "\n"); i += j ? j : n; continue
                }
                w = word(T, i, 0)
                if (WORD_END <= i) { i++; continue }
                i = WORD_END
                if (w == "" && !WORD_QUOTED) continue     # a line continuation
                if (WORD_DYN) printf "D\t%s\n", name
                gsub(/[\t\n]/, " ", w)
                printf "E\t%s\t%s\n", name, w
            }
            printf "X\t%s\n", name                      # no closing parenthesis
            return n
        }

        { sub(/\r$/, ""); L[NR] = $0; T = T $0 "\n" }

        END {
            for (k = 1; k <= NR; k++) {
                line = L[k]
                if (!match(line, /^[[:space:]]*[A-Za-z_][A-Za-z0-9_]*\+?=/)) continue
                lhs = substr(line, 1, RLENGTH); rhs = substr(line, RLENGTH + 1)
                nm = lhs; gsub(/[[:space:]+=]/, "", nm)
                if ((nm in RAW) || lhs ~ /^[[:space:]]/ || lhs ~ /\+=$/ || rhs ~ /^\(/) BAD[nm] = 1
                RAW[nm] = rhs
                word(rhs, 1, 8)
                if (substr(rhs, WORD_END) !~ /^[[:space:]]*([#;].*)?$/) BAD[nm] = 1
            }
            off = 1; upto = 0; cond = 0; doc = ""
            for (k = 1; k <= NR; k++) {
                line = L[k]; start = off; off += length(line) + 1
                if (start <= upto) continue
                if (doc != "") {
                    t = line; sub(/^\t+/, "", t)
                    if (t == doc) doc = ""
                    continue
                }
                if (line !~ /^[[:space:]]*#/ \
                    && match(line, /<<-?[[:space:]]*["\047]?[A-Za-z_][A-Za-z0-9_]*/) \
                    && substr(line, RSTART - 1, 1) != "<") {
                    doc = substr(line, RSTART, RLENGTH); sub(/^<<-?[[:space:]]*["\047]?/, "", doc)
                }
                if (line ~ /^[[:space:]]*(if|case|for|while|until)[[:space:](]/) cond++
                if (match(line, head)) {
                    name = substr(line, 1, RLENGTH)
                    add = (name ~ /\+=\($/)
                    kind = (cond > 0 || line ~ /^[[:space:]]/) ? "cond" : (add ? "add" : "set")
                    gsub(/[[:space:]+=(]/, "", name)
                    upto = array(name, start + RLENGTH, kind)
                    continue
                }
                if (line !~ /^[[:space:]]*#/ && match(line, sub1)) {
                    t = substr(line, RSTART, RLENGTH); at = RSTART + RLENGTH
                    plain = (cond == 0 && line !~ /^[[:space:]]/)
                    sub(/\]=$/, "", t)
                    idx = t; sub(/^.*\[/, "", idx)
                    name = t; sub(/\[[^[]*$/, "", name); sub(/^.*[^A-Za-z0-9_]/, "", name)
                    w = word(line, at, 0)
                    gsub(/[\t\n]/, " ", w)
                    if (plain && idx ~ /^[0-9]+$/) printf "A\t%s\t%s\t%s\n", name, idx, w
                    else printf "D\t%s\n", name
                    if (cond > 0 && line ~ /(^|[[:space:];])(fi|esac|done)[[:space:]]*(#.*)?$/) cond--
                    continue
                }
                if (line !~ /^[[:space:]]*#/ && match(line, mid)) {
                    name = substr(line, RSTART, RLENGTH); at = start + RSTART + RLENGTH - 1
                    sub(/\+?=\($/, "", name); sub(/^.*[^A-Za-z0-9_]/, "", name)
                    upto = array(name, at, "cond")
                    if (cond > 0 && line ~ /(^|[[:space:];])(fi|esac|done)[[:space:]]*(#.*)?$/) cond--
                    continue
                }
                if (cond > 0 && line ~ /(^|[[:space:];])(fi|esac|done)[[:space:]]*(#.*)?$/) cond--
            }
        }'
}

# Where a PKGBUILD and its .SRCINFO disagree, one description per line: nothing
# on stdout means they agree. $1 = the .SRCINFO, $2 = pkgbuild_elements output.
#
# Arrays with one unconditional shape are compared element by element, so a
# different URL, a different hash or a hidden entry all show. Where branches or
# run-time word counts make that impossible, every entry the .SRCINFO claims
# must still appear in the PKGBUILD, and no single statement may say SKIP more
# often than the .SRCINFO does. Another architecture's array is skipped: makepkg
# leaves those out of a .SRCINFO that does not list the architecture.
pkgbuild_mismatches() {
    LC_ALL=C awk -v names="$COMPARED_ARRAYS" '
        BEGIN { U = "\001"; full = "^(" names ")$" }

        # Does element p, which may hold \001 wildcards, fit the text s? Chunks
        # are compared with index(), so nothing from the PKGBUILD is ever used
        # as a regular expression.
        function fits(p, s,    n, t, i, pos, k) {
            if (index(p, U) == 0) return p == s
            n = split(p, t, U)
            if (substr(s, 1, length(t[1])) != t[1]) return 0
            pos = length(t[1]) + 1
            for (i = 2; i < n; i++) {
                if (t[i] == "") continue
                k = index(substr(s, pos), t[i])
                if (!k) return 0
                pos += k - 1 + length(t[i])
            }
            if (length(s) - pos + 1 < length(t[n])) return 0
            return t[n] == "" || substr(s, length(s) - length(t[n]) + 1) == t[n]
        }
        function show(x) { gsub(U, "*", x); return x }

        FNR == NR {
            line = $0; sub(/^[[:space:]]+/, "", line); sub(/[[:space:]]+$/, "", line)
            p = index(line, " = "); if (!p) next
            key = substr(line, 1, p - 1); val = substr(line, p + 3)
            if (key == "arch") ARCH[val] = 1
            if (key ~ full) { S[key, ++Sn[key]] = val; seen[key] = 1 }
            if (key ~ /sums/ && val == "SKIP") Sskip[key]++
            next
        }
        $0 == "" { next }
        {
            split($0, f, "\t"); key = f[2]; seen[key] = 1
            if (f[1] == "S") {
                stmt[key] = 1
                if (f[3] == "set") Pn[key] = 0
                if (f[3] == "cond") loose[key] = 1
                if (f[3] != "add") skips = 0
            } else if (f[1] == "D") {
                loose[key] = 1
            } else if (f[1] == "X") {
                open[key] = 1
            } else if (f[1] == "A") {
                i = f[3] + 1
                P[key, i] = substr($0, length(f[1]) + length(key) + length(f[3]) + 4)
                if (i > Pn[key] + 0) Pn[key] = i
            } else if (f[1] == "E") {
                val = substr($0, length(f[1]) + length(key) + 3)
                P[key, ++Pn[key]] = val
                if (val == "SKIP" && ++skips > Pskip[key] + 0) Pskip[key] = skips
            }
        }
        END {
            for (key in seen) {
                a = key; sub(/^(source|[a-z0-9]+sums|validpgpkeys)_?/, "", a)
                if (a != "" && !(a in ARCH) && !Sn[key]) continue
                if (key in open) {
                    printf "%s: the array is never closed\n", key
                    continue
                }
                if (!(key in stmt)) {
                    printf "%s: in the .SRCINFO, but no such array in the PKGBUILD\n", key
                    continue
                }
                if (key in loose) {
                    if (Pskip[key] + 0 > Sskip[key] + 0) {
                        printf "%s: SKIP x%d in the PKGBUILD, x%d in the .SRCINFO\n", key, Pskip[key], Sskip[key] + 0
                        continue
                    }
                    for (i = 1; i <= Sn[key]; i++) {
                        hit = 0
                        for (j = 1; j <= Pn[key] && !hit; j++) hit = fits(P[key, j], S[key, i])
                        if (!hit) printf "%s[%d]: the .SRCINFO says %s, and the PKGBUILD has nothing like it\n", key, i, S[key, i]
                    }
                } else if (Pn[key] + 0 != Sn[key] + 0) {
                    printf "%s: %d entries in the PKGBUILD, %d in the .SRCINFO\n", key, Pn[key] + 0, Sn[key] + 0
                } else {
                    for (i = 1; i <= Sn[key]; i++) if (!fits(P[key, i], S[key, i]))
                        printf "%s[%d]: PKGBUILD %s, .SRCINFO %s\n", key, i, show(P[key, i]), S[key, i]
                }
            }
        }' <(printf '%s\n' "$1") <(printf '%s\n' "$2")
}

# The remote, non-VCS sources of a .SRCINFO that nothing verifies, one spec per
# line. A source is verified by a real checksum at its own position in a
# checksum array of its own architecture, or by a detached signature listed
# beside it (makepkg: <file>.sig|.sign|.asc, also covering <file>.<compression>
# -- kernel.org signs the uncompressed tar). "Beside it" means fetched with it: a
# signature in source_aarch64 is not on disk when x86_64 builds, so it covers
# files in its own array, and only one in the plain array covers everybody's.
srcinfo_unverified() {
    awk -v algos="$SUM_ALGOS" -v vcs='^(git|hg|svn|bzr|fossil)$' '
        function fname(s,   i) {
            i = index(s, "::"); if (i) return substr(s, 1, i - 1)
            sub(/.*\//, "", s); return s
        }
        # get_protocol, as makepkg has it.
        function proto(s,   u, i) {
            u = s; i = index(u, "::"); if (i) u = substr(u, i + 2)
            if (s ~ /:\/\//) { sub(/:\/\/.*/, "", u); sub(/\+.*/, "", u); return u }
            if (s ~ /lp:/)   { sub(/\+lp:.*/, "", u); return u }
            return "local"
        }
        function cover(a, i, file,    j, t, hit) {
            hit = 0
            for (j = 1; j <= na; j++) {
                t = order[j]
                if ((t == a || a == "") && ((t, file) in names)) {
                    signed[t, file] = 1; issig[a, i] = 1; hit = 1
                }
            }
            return hit
        }
        { sub(/[[:space:]]+$/, "") }
        index($0, " = ") == 0 { next }
        { key = $1; val = substr($0, index($0, " = ") + 3) }
        key ~ /^source(_[A-Za-z0-9_]+)?$/ {
            a = substr(key, 7); if (!(a in n)) order[++na] = a
            src[a, ++n[a]] = val; names[a, fname(val)] = 1; next
        }
        key ~ ("^(" algos ")sums(_[A-Za-z0-9_]+)?$") {
            a = key; sub(/^[a-z0-9]+sums/, "", a)
            if (val != "SKIP") ok[a, ++c[key]] = 1; else ++c[key]
        }
        END {
            ne = split("gz bz2 xz lrz lzo Z zst", ext, " ")
            for (j = 1; j <= na; j++) { a = order[j]
                for (i = 1; i <= n[a]; i++) {
                    f = fname(src[a, i])
                    if (f !~ /\.(sig|sign|asc)$/) continue
                    # A VCS entry named like a signature is handed to the VCS
                    # handler, and verifies no file.
                    if (proto(src[a, i]) ~ vcs) continue
                    b = f; sub(/\.[^.]*$/, "", b)
                    # makepkg verifies the first of these it finds, and only that.
                    if (cover(a, i, b)) continue
                    for (e = 1; e <= ne; e++) if (cover(a, i, b "." ext[e])) break
                }
            }
            for (j = 1; j <= na; j++) { a = order[j]
                for (i = 1; i <= n[a]; i++) {
                    p = proto(src[a, i])
                    if (p == "local" || p ~ vcs) continue
                    if (((a, i) in issig) || ((a, i) in ok) || ((a, fname(src[a, i])) in signed)) continue
                    print src[a, i]
                }
            }
        }'
}

# Print a triage hint after a REJECT, so the override isn't the obvious move:
# an installed orphan is better removed than kept on a re-vet-forever row.
reject_hints() {
    local pkg="$1"
    if pacman -Qq -- "$pkg" >/dev/null 2>&1 \
       && pacman -Qdtq 2>/dev/null | grep -qxF -- "$pkg"; then
        echo "[pin-check] NOTE  $pkg is an orphan (installed as a dep, now required by nothing)." >&2
        echo "    Prefer 'pacman -Rns $pkg' over adding an allowlist row for it." >&2
    fi
}

# The protocol of a source entry, by makepkg's own rule (get_protocol).
source_proto() {
    local spec="$1" u="${1#*::}"
    case "$spec" in
        *://*) u="${u%%://*}"; printf '%s' "${u%%+*}" ;;
        *lp:*) printf '%s' "${u%%+lp:*}" ;;
        *)     printf local ;;
    esac
}

# Is this source entry pinned to an immutable revision for its VCS? It is given
# whole, filename prefix and all, because that is what makepkg parses: everything
# from the first `#` has to be the pin, and nothing else. `?signed` is makepkg
# asking for a signature on top, and only its git handler knows the query.
is_pinned() {
    local spec="$1" frag
    [[ "$spec" == *'#'* ]] || return 1
    frag="${spec#*#}"
    case "$(source_proto "$spec")" in
        git)     [[ "$frag" =~ ^commit=[0-9a-fA-F]{40}(\?signed)?$ ]] ;;
        fossil)  [[ "$frag" =~ ^commit=([0-9a-fA-F]{40}|[0-9a-fA-F]{64})$ ]] ;;
        hg)      [[ "$frag" =~ ^revision=[0-9a-fA-F]{40}$ ]] ;;
        svn|bzr) [[ "$frag" =~ ^revision=[0-9]+$ ]] ;;
        *)       return 1 ;;
    esac
}

# Is this dependency string met without building anything from the AUR — by
# what is installed, or by a binary repository? Those are the deps yay leaves
# alone; anything else it builds, so --deps checks it. A group is not a
# dependency: -Sddp expands `arduino` to its members and says yes, while yay
# goes and builds the AUR package of that name.
dep_met() {
    local name="${1%%[<>=]*}"
    pacman -T -- "$1" >/dev/null 2>&1 && return 0
    if pacman -Sg -- "$name" >/dev/null 2>&1 && ! pacman -Si -- "$name" >/dev/null 2>&1; then
        return 1
    fi
    LC_ALL=C pacman -Sddp --noconfirm --print-format '%n' -- "$1" >/dev/null 2>&1
}

# The work queue. Names given on the command line, plus — with --deps — the
# AUR dependencies found while checking them. queue_aur marks the entries that
# are built from the AUR whatever the repos carry; queue_for names the package
# a dependency was found under, for the error message.
queue=("$@")
queue_aur=()
queue_for=()
for _ in "$@"; do queue_aur+=("$from_aur"); queue_for+=(""); done
declare -A seen=()

fail=0
for (( qi = 0; qi < ${#queue[@]}; qi++ )); do
    pkg=${queue[qi]}
    if ! valid_name "$pkg"; then
        printf '[pin-check] ERROR %s: not a package name\n' "$pkg" | clean >&2
        fail=1
        continue
    fi
    [[ -n "${seen[$pkg]:-}" ]] && continue
    seen[$pkg]=1

    # A name a binary repo carries is what `yay -S` installs from that repo —
    # unless the caller is building it from the AUR regardless (--from-aur).
    if (( ! queue_aur[qi] )) && pacman -Si -- "$pkg" >/dev/null 2>&1; then
        continue
    fi

    if (( name_is_base )); then
        base=$pkg
    else
        base=$(aur_pkgbase "$pkg"); where=$?
        if (( where == 1 )); then
            if [[ -n "${queue_for[qi]}" ]]; then
                echo "[pin-check] ERROR $pkg (a dependency of ${queue_for[qi]}): NOT in the AUR index." >&2
                echo "    no repo package satisfies it and the AUR has no package by that name." >&2
                echo "    If an AUR package PROVIDES it, install that one first, then retry." >&2
            else
                echo "[pin-check] ERROR $pkg: NOT in the AUR index — deleted, renamed, or never there." >&2
                echo "    cgit still serves deleted packages' repos, and what it has may be years stale." >&2
                echo "    Find the real package first:  pacman -Ss $pkg   |   pacman -F $pkg" >&2
            fi
            fail=1
            continue
        elif (( where != 0 )); then
            echo "[pin-check] ERROR $pkg${queue_for[qi]:+ (a dependency of ${queue_for[qi]})}: could not ask the AUR index about it — not checked." >&2
            fail=1
            continue
        fi
    fi

    srcinfo=$(fetch_srcinfo "$base") || {
        echo "[pin-check] ERROR $pkg: cannot fetch .SRCINFO from AUR" >&2
        fail=1
        continue
    }
    # Is it one? And for this package? Anything else passes every test below by
    # containing nothing they object to.
    got=$(awk '$1 == "pkgbase" && $2 == "=" { print $3; exit }' <<<"$srcinfo")
    if [[ "$got" != "$base" ]]; then
        printf '[pin-check] ERROR %s: what came back is not the .SRCINFO of %s (pkgbase: %s)\n' \
            "$pkg" "$base" "${got:-none}" | clean >&2
        fail=1
        continue
    fi
    if (( ! name_is_base )) && ! awk -v p="$pkg" '$1 == "pkgname" && $3 == p { f = 1 } END { exit !f }' <<<"$srcinfo"; then
        echo "[pin-check] ERROR $pkg: the .SRCINFO of $base does not list a package by that name" >&2
        fail=1
        continue
    fi

    if (( walk_deps )); then
        # Only what this machine would pull in: a dependency of another
        # architecture is not a dependency here, and refusing over one that
        # only an aarch64 build needs would be refusing a package for nothing.
        while IFS= read -r dep; do
            [[ -n "$dep" ]] || continue
            dep_met "$dep" && continue
            dname="${dep%%[<>=]*}"
            [[ -n "${seen[$dname]:-}" ]] && continue
            queue+=("$dname"); queue_aur+=(1); queue_for+=("$pkg")
        done < <(awk -v arch="$(uname -m)" '
            { sub(/^[[:space:]]+/, ""); p = index($0, " = "); if (!p) next
              key = substr($0, 1, p - 1); sub("_" arch "$", "", key)
              if (key ~ /^(depends|makedepends|checkdepends)$/) print substr($0, p + 3) }' <<<"$srcinfo")
    fi

    # Extract the sources. .SRCINFO format: "\tsource = <spec>", plus the
    # arch-specific arrays "\tsource_x86_64 = <spec>" — which are sources exactly
    # as much as the plain array is. A value runs to the end of the line.
    unpinned=()
    srcinfo_vcs=0
    allowed=0
    rejected=0
    while IFS= read -r spec; do
        # Only VCS sources: every protocol makepkg supports, by makepkg's rule,
        # so `git+https-fix.patch` stays the local file it is.
        case "$(source_proto "$spec")" in
            git|hg|svn|bzr|fossil) ;;
            *) continue ;;
        esac
        srcinfo_vcs=$((srcinfo_vcs + 1))
        is_pinned "$spec" && continue
        # Allowlist: tag→SHA verification against recorded expected SHA.
        url="${spec#*::}"
        expected_sha=""
        allowlistable "$spec" && expected_sha=$(allowlist_sha "$base" "$url")
        if [[ -n "$expected_sha" ]]; then
            actual_sha=$(resolve_git_tag "$url")
            if [[ -z "$actual_sha" ]]; then
                echo "[pin-check] REJECT $pkg: allowlisted source but tag did not resolve:" >&2
                echo "    $url" >&2
                fail=1; rejected=1
            elif [[ "$actual_sha" != "$expected_sha" ]]; then
                echo "[pin-check] REJECT $pkg: allowlisted tag moved upstream!" >&2
                echo "    source:   $url" >&2
                echo "    expected: $expected_sha" >&2
                echo "    actual:   $actual_sha" >&2
                echo "    if intentional, update $ALLOWLIST" >&2
                fail=1; rejected=1
            else
                allowed=$((allowed + 1))
            fi
            continue
        fi
        unpinned+=("$spec")
    done < <(awk '
        { sub(/^[[:space:]]+/, ""); sub(/[[:space:]]+$/, ""); p = index($0, " = "); if (!p) next }
        substr($0, 1, p - 1) ~ /^source(_[A-Za-z0-9_]+)?$/ { print substr($0, p + 3) }' <<<"$srcinfo")

    # The other half of "what am I building": a download nothing verifies.
    if ! list=$(srcinfo_unverified <<<"$srcinfo"); then
        echo "[pin-check] ERROR $pkg: could not read the .SRCINFO's checksums" >&2
        fail=1
        continue
    fi
    unverified=()
    [[ -z "$list" ]] || mapfile -t unverified <<<"$list"

    if (( ${#unpinned[@]} > 0 )); then
        echo "[pin-check] REJECT $pkg: ${#unpinned[@]} unpinned VCS source(s):" >&2
        printf '    %s\n' "${unpinned[@]}" | clean >&2
    fi
    if (( ${#unverified[@]} > 0 )); then
        echo "[pin-check] REJECT $pkg: ${#unverified[@]} download(s) that nothing verifies (checksum SKIP, no signature):" >&2
        printf '    %s\n' "${unverified[@]}" | clean >&2
        echo "    makepkg will build whatever that URL serves on the day, unchecked." >&2
        echo "    No allowlist row covers this: a moving download has no revision to record." >&2
    fi
    if (( ${#unpinned[@]} > 0 || ${#unverified[@]} > 0 )); then
        reject_hints "$pkg"
        fail=1
        continue
    fi
    (( rejected )) && continue

    # The tripwire: does the PKGBUILD agree with the .SRCINFO it was judged by?
    # An unpinned VCS URL in the PKGBUILD's source arrays is legitimate only as
    # an allowlisted tag, so there can be no more of them than were allowed —
    # and a PKGBUILD naming VCS sources at all, under a .SRCINFO naming none,
    # is a .SRCINFO that does not describe it.
    pkgbuild=$(fetch_pkgbuild "$base") || {
        echo "[pin-check] ERROR $pkg: cannot fetch the PKGBUILD from AUR (needed to confirm the .SRCINFO)" >&2
        fail=1
        continue
    }
    if ! grep -qE '^[[:space:]]*(pkgname|pkgbase)=' <<<"$pkgbuild"; then
        echo "[pin-check] ERROR $pkg: what came back is not a PKGBUILD" >&2
        fail=1
        continue
    fi
    rows=$(pkgbuild_elements <<<"$pkgbuild") || {
        echo "[pin-check] ERROR $pkg: could not read the PKGBUILD's arrays" >&2
        fail=1
        continue
    }
    pb_unpinned=()
    pb_total=0
    while IFS=$'\t' read -r _ _ u; do
        case "$(source_proto "$u")" in
            git|hg|svn|bzr|fossil) ;;
            *) continue ;;
        esac
        u="${u#*::}"
        pb_total=$((pb_total + 1))
        # A \001 is an expansion nobody can read without running it, and it may
        # well be the pin: ${_commit:+#commit=$_commit} is a real idiom.
        [[ "$u" == *'#commit='* || "$u" == *'#revision='* || "$u" == *$'\001'* ]] || pb_unpinned+=("$u")
    done < <(awk -F'\t' -v archs="$(awk '$1 == "arch" { print $3 }' <<<"$srcinfo")" '
        BEGIN { n = split(archs, t, "\n"); A["source"] = 1
                for (i = 1; i <= n; i++) A["source_" t[i]] = 1 }
        $1 == "E" && ($2 in A)' <<<"$rows")
    if (( ${#pb_unpinned[@]} > allowed || (pb_total > 0 && srcinfo_vcs == 0) )); then
        echo "[pin-check] REJECT $pkg: the PKGBUILD does not match its .SRCINFO." >&2
        echo "    .SRCINFO lists $srcinfo_vcs VCS source(s); the PKGBUILD's source arrays name $pb_total," >&2
        echo "    ${#pb_unpinned[@]} of them without a pinned revision:" >&2
        printf '    %s\n' "${pb_unpinned[@]:-"(all pinned, but absent from .SRCINFO)"}" | clean >&2
        echo "    A .SRCINFO that hides a source is how a gate like this one is fooled." >&2
        echo "    Read the PKGBUILD before trusting this package:" >&2
        printf '    %s\n' "$(printf "$AUR_PKGBUILD_URL" "$(urlenc "$base")")" >&2
        fail=1
        continue
    fi

    # The same question for everything else: makepkg obeys the PKGBUILD, and the
    # .SRCINFO is what was judged above, so a URL, a checksum or a signing key
    # that differs between them means the verdict was about something else.
    if ! diffs=$(pkgbuild_mismatches "$srcinfo" "$rows"); then
        echo "[pin-check] ERROR $pkg: could not compare the PKGBUILD with its .SRCINFO" >&2
        fail=1
        continue
    fi
    if [[ -n "$diffs" ]]; then
        echo "[pin-check] REJECT $pkg: the PKGBUILD does not match its .SRCINFO." >&2
        sort <<<"$diffs" | sed 's/^/    /' | clean >&2
        echo "    makepkg obeys the PKGBUILD. Read it before trusting this package:" >&2
        printf '    %s\n' "$(printf "$AUR_PKGBUILD_URL" "$(urlenc "$base")")" >&2
        fail=1
    fi
done

exit "$fail"
