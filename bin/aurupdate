#!/bin/bash
# aurupdate — yay -Sua with pin-check on packages about to be upgraded.
#
# Runs aur-pin-check against every AUR package that has a pending upgrade,
# and every AUR dependency those upgrades would pull in. If any fail, aborts:
# a maintainer adding an unpinned VCS source on upgrade is stopped here, so is
# one switching a checksum to SKIP, and so is a .SRCINFO that hides either
# from its PKGBUILD.
#
# A pin is not a review. A hostile maintainer can do anything in build(), so
# the suite's ~/.config/yay/config.json keeps yay's PKGBUILD diff menu ON
# (diffmenu=true): read what changed before it builds.

set -uo pipefail

# yay gets exactly what the gate was shown. A package name here would reach
# `yay -Sua` without being in the pending list; an option such as --devel has to
# reach -Qua as well, or the set it adds is one nothing looked at.
for a in "$@"; do
    case "$a" in
        -*) ;;
        *) echo "[aurupdate] takes no package names ('$a'): use aurinstall for that" >&2; exit 2 ;;
    esac
done

command -v yay >/dev/null 2>&1 || { echo "[aurupdate] ERROR: yay is not installed" >&2; exit 2; }

# -Qua exits 1 whether nothing is pending or the AUR could not be reached. Only
# the second says anything on stderr, and it is not "no upgrades pending".
err=$(mktemp) || exit 2
trap 'rm -f "$err"' EXIT
pending=$(yay -Qua "$@" 2>"$err"); rc=$?
if (( rc != 0 )) && [[ -s "$err" ]]; then
    echo "[aurupdate] ERROR: could not ask which AUR upgrades are pending:" >&2
    sed 's/^/    /' "$err" >&2
    exit 1
fi
upgrades=()
[[ -z "$pending" ]] || mapfile -t upgrades < <(awk '{print $1}' <<<"$pending")

if (( ${#upgrades[@]} == 0 )); then
    echo "[aurupdate] no AUR upgrades pending" >&2
    exit 0
fi

echo "[aurupdate] pin-checking ${#upgrades[@]} pending AUR upgrade(s)..." >&2
if ! aur-pin-check --deps "${upgrades[@]}"; then
    echo "" >&2
    echo "[aurupdate] aborting — the pin check refused a pending upgrade or one of its AUR dependencies." >&2
    echo "[aurupdate] override, once you have read the PKGBUILDs: yay -Sua" >&2
    exit 1
fi

exec yay -Sua "$@"
